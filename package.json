{
  "name": "meut",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "sh scripts/boot.sh",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "import:mdb": "tsx scripts/import-mdb.ts",
    "postinstall": "prisma generate",
    "start:railway": "npx prisma db push && npm run start",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "start:next": "next start -H 0.0.0.0 -p ${PORT:-3000}"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "localtunnel": "^2.0.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "description": "M.E.U.T. \u2014 Medical Equipment User Tracking (modern CMMS)",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
